{
  "name": "football-11",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "demo:capture": "node tools/demo/capture.mjs",
    "demo:edit": "node tools/demo/edit.mjs",
    "demo:friends:capture": "node tools/demo/capture-friends.mjs",
    "demo:friends:edit": "node tools/demo/edit-friends.mjs",
    "build": "tsc -b && npm run build --workspace @football-11/web",
    "clean": "tsc -b --clean",
    "format": "oxfmt package.json tsconfig.base.json tsconfig.json vitest.config.ts packages apps/web tools/mechanics",
    "format:check": "oxfmt --check package.json tsconfig.base.json tsconfig.json vitest.config.ts packages apps/web tools/mechanics",
    "lint": "oxlint --type-aware packages apps/web/app apps/web/src apps/web/preview apps/web/vite.config.ts apps/web/vite.preview.config.ts apps/web/next.config.ts tools/mechanics vitest.config.ts",
    "ags:auth:smoke": "node --env-file=apps/web/.env.local tools/ags/smoke-device-login.mjs",
    "ags:cloud-save:smoke": "node --env-file=apps/web/.env.local tools/ags/smoke-device-login.mjs --cloud-save",
    "ags:trusted-ranking:smoke": "node --env-file=apps/web/.env.local tools/ags/smoke-trusted-ranking.mjs",
    "ags:saved-xi:smoke": "node --env-file=apps/web/.env.local tools/ags/smoke-saved-xi.mjs",
    "mechanics:offers": "npm run build --silent && node tools/mechanics/analyze-offers.mjs",
    "mechanics:fixture": "npm run build --silent && node tools/mechanics/run-fixture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && npm run typecheck --workspace @football-11/web",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
