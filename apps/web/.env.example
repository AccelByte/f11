NEXT_PUBLIC_ACCELBYTE_BASE_URL=https://your-environment.gamingservices.accelbyte.io
NEXT_PUBLIC_ACCELBYTE_NAMESPACE=your-game-namespace
NEXT_PUBLIC_ACCELBYTE_CLIENT_ID=your-public-client-id
NEXT_PUBLIC_ACCELBYTE_REDIRECT_URI=http://127.0.0.1
NEXT_PUBLIC_FRIEND_ROOM_MAX_PLAYERS=8
NEXT_PUBLIC_FRIEND_ROOM_ROUND_SECONDS=900
NEXT_PUBLIC_FRIEND_ROOM_COUNTDOWN_SECONDS=30

# Public browser ingestion key, required for the GitHub Pages build only.
# Use the existing PostHog project's key, never a personal API key.
NEXT_PUBLIC_POSTHOG_KEY=your-public-posthog-project-key

# Server runtime only. Never expose these as NEXT_PUBLIC_* values.
ACCELBYTE_SERVER_CLIENT_ID=your-confidential-server-client-id
ACCELBYTE_SERVER_CLIENT_SECRET=your-confidential-server-client-secret
