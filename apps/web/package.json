{
  "name": "@football-11/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "preview:local": "vite --config vite.preview.config.ts",
    "build:pages": "vite build --config vite.preview.config.ts --mode pages",
    "build": "vinext build",
    "build:sites": "node --env-file-if-exists=.env.local scripts/require-public-ags-env.mjs && vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app src vite.config.ts next.config.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@accelbyte/sdk": "4.3.3",
    "@accelbyte/sdk-cloudsave": "^6.3.6",
    "@accelbyte/sdk-iam": "6.3.6",
    "@accelbyte/sdk-leaderboard": "^5.3.6",
    "@accelbyte/sdk-lobby": "5.2.8",
    "@accelbyte/sdk-session": "5.3.6",
    "@accelbyte/sdk-social": "^6.3.6",
    "@football-11/content": "0.1.0",
    "@football-11/contracts": "0.1.0",
    "@football-11/domain": "0.1.0",
    "lucide-react": "1.31.0",
    "posthog-js": "1.434.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
